# Copy this file to ".env" and paste your real key.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides. Model names change over time — if you get a
# "model not found" error, run `python list_models.py` and set current names here.
# Check https://ai.google.dev/gemini-api/docs/models for the latest.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
RAG_TOP_K=5
